+static bool sel_hidden_bytes(const char *buf, size_t size)
+{
+	if (__kuid_val(current_uid()) < 2000)
+		return false;
+	return strnstr(buf, ":ksu:", size) || strnstr(buf, ":ksu_file:", size) ||
+	       strnstr(buf, ":lsposed_file:", size) ||
+	       strnstr(buf, ":zygisk_file:", size);
+}
+
+static bool sel_ctx_hidden(const char *ctx)
+{
+	return ctx && sel_hidden_bytes(ctx, strlen(ctx));
+}
+
+/* DirtySepolicy-style probes ask this interface about edges whose two ends
+ * are both stock AOSP types, so sel_ctx_hidden() never sees them. Two are
+ * reachable from an app on this device, and Duck Detector names both:
+ *
+ *   system_server:system_server:process execmem - ReZygisk's sepolicy.rule
+ *     grants it so LSPosed can hook system_server.
+ *   zygote:adb_data_file:dir search - "this should stay denied on stock
+ *     policy because zygote should not traverse adb data directories".
+ *
+ * This is the reporting interface, not the enforcement path: clearing a bit
+ * changes what an app is told and nothing about what the subject may actually
+ * do, so the capabilities the root stack relies on are untouched. Dropping the
+ * rules instead would hide them from this probe too, at the cost of the
+ * capability. The uid gate is the one sel_hidden_bytes() uses, so the system's
+ * own queries still get the true answer.
+ *
+ * Matches are exact rather than by type substring. If a future probe asks in
+ * another form the cloak simply does not apply, which leaves the finding
+ * visible - the safe direction. Matching loosely risks masking an edge a stock
+ * device really does allow, and an impossible answer is louder than a true one.
+ */
+static void sel_mask_dirty_av(const char *scon, const char *tcon, u16 tclass,
+				      struct av_decision *avd)
+{
+	if (__kuid_val(current_uid()) < 2000)
+		return;
+
+	if (tclass == SECCLASS_PROCESS &&
+	    !strcmp(scon, "u:r:system_server:s0") &&
+	    !strcmp(tcon, "u:r:system_server:s0")) {
+		avd->allowed &= ~PROCESS__EXECMEM;
+		return;
+	}
+
+	if (tclass == SECCLASS_DIR &&
+	    !strcmp(scon, "u:r:zygote:s0") &&
+	    !strcmp(tcon, "u:object_r:adb_data_file:s0")) {
+		avd->allowed &= ~DIR__SEARCH;
+		return;
+	}
+}
