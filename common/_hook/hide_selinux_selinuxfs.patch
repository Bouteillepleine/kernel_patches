+/*
+ * Shared hidden-type gate for the selinuxfs write handlers below. The type
+ * list lives here and is mirrored in security/selinux/hooks.c
+ * (selinux_lsm_setattr / selinux_inode_setxattr), security/selinux/avc.c
+ * (slow_avc_audit) and kernel/audit.c (audit_receive_msg) -- adding a type
+ * means editing all of them. Length-bounded strnstr, never strstr. Call it
+ * only AFTER the handler's own avc_has_perm has passed, so a domain lacking
+ * the perm still gets the stock EACCES and the cloak never becomes the tell.
+ */
+static bool sel_ctx_hidden(const char *buf, size_t size)
+{
+	if (__kuid_val(current_uid()) < 2000)
+		return false;
+	return strnstr(buf, ":ksu:", size) || strnstr(buf, ":ksu_file:", size) ||
+	       strnstr(buf, ":lsposed_file:", size) ||
+	       strnstr(buf, ":zygisk_file:", size);
+}
+
