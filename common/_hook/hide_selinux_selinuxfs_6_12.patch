+static bool sel_hidden_bytes(const char *buf, size_t size)
+{
+	if (__kuid_val(current_uid()) < 2000)
+		return false;
+	return strnstr(buf, ":ksu:", size) || strnstr(buf, ":ksu_file:", size) ||
+	       strnstr(buf, ":lsposed_file:", size) ||
+	       strnstr(buf, ":zygisk_file:", size);
+}
+
+/*
+ * Rewrite a hidden type in place so the stock parser rejects it on its own.
+ *
+ * Returning -EINVAL from here used to skip security_context_to_sid() entirely,
+ * and skipping it is measurable. On an OP15 (6.12.69) from uid 10500, writing
+ * u:r:ksu:s0 to /sys/fs/selinux/context was rejected 208ns faster than any
+ * 10-byte type merely absent from policy -- seven different controls, same
+ * number every time -- and u:object_r:ksu_file:s0 312ns faster than a 22-byte
+ * control, on 99.9% of pairs, while unknown-against-unknown sat at exactly 0ns.
+ * The cost is entering the parser at all (the kmemdup_nul and the call), not
+ * the symtab walk: a context with no ':' at all, which dies at the first field,
+ * measured the same as one that walks to the type lookup. Duck Detector reads
+ * the gap as its "ksu_types timing with invalid types" row.
+ *
+ * Poisoning keeps the caller on the stock path, so a hidden type pays what an
+ * unknown type pays and the -EINVAL comes from the policy rather than from us.
+ *
+ * Length is preserved deliberately: the delta tracks the size handed to
+ * kmemdup_nul, so a shorter replacement would reopen the gap it closes. '#'
+ * cannot occur in a policy identifier, so a poisoned name can never collide
+ * with a real type.
+ *
+ * Do NOT fold this back into an early return, and do not move the test after
+ * the parse either: below the uid gate, where the hidden type is valid and
+ * takes the success path, the same measurement reads +364ns, so testing
+ * afterwards flips the sign instead of closing the gap.
+ */
+static bool sel_poison_ctx(char *ctx)
+{
+	char *p;
+	int colons = 0;
+
+	if (!ctx || !sel_hidden_bytes(ctx, strlen(ctx)))
+		return false;
+
+	/* user:role:type:level -- poison the type, so the parse dies where an
+	 * unknown type dies.
+	 */
+	for (p = ctx; *p; p++) {
+		if (*p != ':')
+			continue;
+		if (++colons == 2 && p[1]) {
+			p[1] = '#';
+			return true;
+		}
+	}
+
+	/* Too malformed to have a type field. Poison the first byte so it still
+	 * cannot resolve, rather than handing it to the parser intact.
+	 */
+	*ctx = '#';
+	return true;
+}
