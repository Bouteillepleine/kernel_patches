@@ -290,21 +304,29 @@
 static int proc_readfd_count(struct inode *inode, loff_t *count)
 {
 	struct task_struct *p = get_proc_task(inode);
-	struct fdtable *fdt;
+	extern bool pathhide_match_file(struct file *f);
+	unsigned int fd = 0;
+	loff_t n = 0;
 
 	if (!p)
