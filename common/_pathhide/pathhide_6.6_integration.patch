Hide pathhide-matched files from /proc/<pid>/maps, smaps, smaps_rollup,
numa_maps and /proc/<pid>/fd (readdir, lookup, readlink and fdinfo).

Generated hunk by hunk against the real tree the fleet pins for this kernel
version:

    OnePlusOSS/android_kernel_common_oneplus_sm8750 @ oneplus/sm8750_b_16.0.0_oneplus_13

and dry-run at fuzz 0 against every distinct fs/proc variant the manifests
resolve to. A hunk that only lands "with fuzz" can silently guard the wrong
function, so treat a fuzz report from `patch` as a failure and regenerate.

Version notes:
  * proc_readfd_count() exists here and reports the TRUE fd count via
    bitmap_weight() on the fdtable, bypassing the readdir filter exactly, so
    stat(/proc/<pid>/fd).st_size leaks the number of hidden fds. It is rewritten
    to count what readdir emits. 6.6 has task_lookup_next_fd_rcu() (no
    reference taken), not 6.12's task_lookup_next_fdget_rcu().
  * show_map()/show_smap() take @v as the VMA directly on every 6.6 tree in the
    fleet -- no pad copies to free -- so the guard sits inline exactly as it
    does on 6.12.
  * smaps_rollup is a do/while here, so `continue` reaches the advance.
--- a/fs/proc/fd.c
+++ b/fs/proc/fd.c
@@ -117,9 +117,16 @@
 static bool tid_fd_mode(struct task_struct *task, unsigned fd, fmode_t *mode)
 {
 	struct file *file;
+	extern bool pathhide_match_file(struct file *f);
 
 	rcu_read_lock();
 	file = task_lookup_fd_rcu(task, fd);
+	/* Hide matched fds from lookup, readlink and fdinfo, and from
+	 * d_revalidate so a cached dentry re-checks and vanishes too.
+	 * Filtering proc_readfd_common() alone leaves readlink(/proc/pid/fd/N)
+	 * returning the hidden path verbatim and fdinfo/N still openable. */
+	if (file && pathhide_match_file(file))
+		file = NULL;
 	if (file)
 		*mode = file->f_mode;
 	rcu_read_unlock();
@@ -184,9 +191,13 @@
 
 		fd_file = fget_task(task, fd);
 		if (fd_file) {
-			*path = fd_file->f_path;
-			path_get(&fd_file->f_path);
-			ret = 0;
+			extern bool pathhide_match_file(struct file *f);
+
+			if (!pathhide_match_file(fd_file)) {
+				*path = fd_file->f_path;
+				path_get(&fd_file->f_path);
+				ret = 0;
+			}
 			fput(fd_file);
 		}
 		put_task_struct(task);
@@ -251,6 +262,7 @@
 {
 	struct task_struct *p = get_proc_task(file_inode(file));
 	unsigned int fd;
+	extern bool pathhide_match_file(struct file *f);
 
 	if (!p)
