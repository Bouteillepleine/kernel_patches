-		fdt = files_fdtable(p->files);
-		*count = bitmap_weight(fdt->open_fds, fdt->max_fds);
-
-		rcu_read_unlock();
+		if (!f)
+			break;
+		if (!pathhide_match_file(f))
+			n++;
