Extend pathhide coverage to /proc/<pid>/map_files/ (readdir listing, name
lookup, and symlink resolution). Without this, a process can enumerate its own
injected file-backed mappings via /proc/self/map_files/ even though they are
hidden from /proc/self/maps -- the address ranges alone prove concealment.
MANDATORY, not optional: on 6.x /proc/<pid>/map_files is compiled
unconditionally -- there is NO CONFIG_CHECKPOINT_RESTORE guard around it (an
earlier note here was wrong). Confirmed on the 6.12 sibling with
CONFIG_CHECKPOINT_RESTORE=n; the same holds on 6.1. Skipping this patch leaves
the map_files enumeration oracle open even though maps/smaps are cloaked.

Generated and verified against android14-6.1.

--- a/fs/proc/base.c
+++ b/fs/proc/base.c
@@ -64,4 +64,5 @@
 #include <linux/seq_file.h>
 #include <linux/namei.h>
+extern bool pathhide_match_file(struct file *file);
 #include <linux/mnt_namespace.h>
 #include <linux/mm.h>
@@ -2289,7 +2290,7 @@
 
 	rc = -ENOENT;
 	vma = find_exact_vma(mm, vm_start, vm_end);
-	if (vma && vma->vm_file) {
+	if (vma && vma->vm_file && !pathhide_match_file(vma->vm_file)) {
 		*path = vma->vm_file->f_path;
 		path_get(path);
 		rc = 0;
@@ -2392,7 +2393,7 @@
 	if (!vma)
 		goto out_no_vma;
 
-	if (vma->vm_file)
+	if (vma->vm_file && !pathhide_match_file(vma->vm_file))
 		result = proc_map_files_instantiate(dentry, task,
 				(void *)(unsigned long)vma->vm_file->f_mode);
 
@@ -2465,6 +2466,8 @@
 	vma_iter_init(&vmi, mm, 0);
 	for_each_vma(vmi, vma) {
 		if (!vma->vm_file)
+			continue;
+		if (pathhide_match_file(vma->vm_file))
 			continue;
 		if (++pos <= ctx->pos)
 			continue;
