From: Bouteillepleine <76688492+Bouteillepleine@users.noreply.github.com>
Subject: [PATCH] module: stub the OnePlus qcom_scm anti-rollback commit at load

---
--- a/kernel/module/main.c
+++ b/kernel/module/main.c
@@ -3301,6 +3301,69 @@
  * Allocate and load the module: note that size of section 0 is always
  * zero, and we rely on this for optional sections.
  */
+#ifdef CONFIG_ARM64
+/*
+ * OnePlus/OPPO qcom_scm exports qcom_scm_update_rollback_version(), an SMC
+ * that commits the anti-rollback version to fuses. Stub it to return 0 in the
+ * vendor's own module image before layout; a module without that function, or
+ * with an unexpected prologue, is left untouched.
+ */
+static void arb_guard(struct load_info *info)
+{
+	static const u32 stub[3] = {
+		0xd50323bf,	/* autiasp */
+		0x52800000,	/* mov w0, #0 */
+		0xd65f03c0,	/* ret */
+	};
+	Elf_Shdr *symsec = &info->sechdrs[info->index.sym];
+	Elf_Sym *sym = (void *)info->hdr + symsec->sh_offset;
+	unsigned int i, j, k, nsym = symsec->sh_size / sizeof(*sym);
+
+	if (strcmp(info->name, "qcom_scm"))
+		return;
+
+	for (i = 1; i < nsym; i++) {
+		Elf_Shdr *text;
+		u32 *insn;
+
+		if (ELF_ST_TYPE(sym[i].st_info) != STT_FUNC ||
+		    strcmp(info->strtab + sym[i].st_name,
+			   "qcom_scm_update_rollback_version"))
+			continue;
+
+		if (sym[i].st_shndx == SHN_UNDEF ||
+		    sym[i].st_shndx >= info->hdr->e_shnum || sym[i].st_size < 16)
+			return;
+		text = &info->sechdrs[sym[i].st_shndx];
+		if (text->sh_type != SHT_PROGBITS ||
+		    sym[i].st_value + 16 > text->sh_size)
+			return;
+
+		for (j = 1; j < info->hdr->e_shnum; j++) {
+			Elf_Shdr *rs = &info->sechdrs[j];
+			Elf_Rela *rel = (void *)info->hdr + rs->sh_offset;
+
+			if (rs->sh_type != SHT_RELA || rs->sh_info != sym[i].st_shndx)
+				continue;
+			for (k = 0; k < rs->sh_size / sizeof(*rel); k++)
+				if (rel[k].r_offset >= sym[i].st_value + 4 &&
+				    rel[k].r_offset < sym[i].st_value + 16)
+					return;
+		}
+
+		insn = (void *)info->hdr + text->sh_offset + sym[i].st_value;
+		if (le32_to_cpu(insn[0]) != 0xd503233f)	/* paciasp */
+			return;
+		for (k = 0; k < ARRAY_SIZE(stub); k++)
+			insn[k + 1] = cpu_to_le32(stub[k]);
+		pr_debug("arb_guard: %s stubbed\n", info->name);
+		return;
+	}
+}
+#else
+static inline void arb_guard(struct load_info *info) { }
+#endif
+
 static int load_module(struct load_info *info, const char __user *uargs,
 		       int flags)
 {
@@ -3337,6 +3400,8 @@
 	err = early_mod_check(info, flags);
 	if (err)
 		goto free_copy;
+
+	arb_guard(info);
 
 	/* Figure out module layout, and allocate all the memory. */
 	mod = layout_and_allocate(info, flags);
